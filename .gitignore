# Ava ecosystem exclusions

# User folders not part of the ecosystem repository
[Ss]creenshots/
[Pp]ictures/
snap/
Desktop/

# Environment files and variants
.env
.env.*
**/.env
**/.env.*

# Keep safe example templates
!.env.example
!.env.*.example

# Cloudflare credentials — never commit
Web/cloudflare/**/*.token
Web/cloudflare/**/*.pem
Web/cloudflare/**/*.json
Web/cloudflare/**/cert.pem
